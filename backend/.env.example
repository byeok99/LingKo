APP_PORT=8080

DB_HOST=mysql
DB_PORT=3306
DB_NAME=lingko
DB_USER=lingko
DB_PASSWORD=
DB_DRIVER=com.mysql.cj.jdbc.Driver
DB_TZ=Asia/Seoul
JPA_DDL_AUTO=none

JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14
JWT_ALGORITHM=HS256

OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-4o-mini

AZURE_SECRET_KEY=
AZURE_REGION=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# native iOS Sign in with Apple App ID(Bundle ID). 예: com.example.app
APPLE_CLIENT_ID=

# App Review 기간에만 활성화한다. 원문 코드는 저장하지 않고 SHA-256 hex와 기존 사용자 ID만 주입한다.
REVIEW_ACCESS_ENABLED=false
REVIEW_ACCESS_CODE_SHA256=
REVIEW_ACCESS_USER_ID=
REVIEW_ACCESS_MAX_ATTEMPTS=5
REVIEW_ACCESS_WINDOW_SECONDS=300

REPLICATE_API_KEY=
REPLICATE_VERSION=
REPLICATE_MAX_POLL_ATTEMPTS=300
REPLICATE_POLL_INTERVAL_MS=1000
REPLICATE_CREATE_MAX_ATTEMPTS=4
REPLICATE_RETRY_INITIAL_DELAY_MS=1000
REPLICATE_RETRY_MAX_DELAY_MS=30000
REPLICATE_FRAME_RATE=24

AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_ACCESS_KEY=
AWS_SECRET_KEY=

EVALUATION_API_WORKER_ENABLED=false
EVALUATION_WORKER_LEASE_SECONDS=600

# 가이드 생성 HTTP API는 기본 비활성화한다. 활성화 시 32자 이상의 별도 Secret을 주입한다.
GUIDE_JOBS_API_ENABLED=false
GUIDE_JOBS_INTERNAL_TOKEN=
GUIDE_JOBS_REQUESTS_PER_MINUTE=2
GUIDE_JOBS_MAX_CONCURRENT=1

FFMPEG_PATH=ffmpeg
LOG_LEVEL=DEBUG
# AdMob Rewarded SSV는 전체 ca-app-pub ID가 아니라 callback의 숫자 ad_unit 값을 쉼표로 구분한다.
ADMOB_SSV_ENABLED=true
ADMOB_SSV_ALLOWED_AD_UNIT_IDS=iOS-numeric-ad-unit-id,Android-numeric-ad-unit-id
ADMOB_SSV_REWARD_ITEM=pronunciation_chance
ADMOB_SSV_REWARD_AMOUNT=1
ADMOB_SSV_SESSION_EXPIRY_MINUTES=15
