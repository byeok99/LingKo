APP_PORT=8080
# 같은 host의 TLS reverse proxy만 Backend에 접근하면 127.0.0.1로 제한한다. 기본값은 0.0.0.0이다.
APP_BIND_ADDRESS=0.0.0.0
# 로컬 Compose 기본 image 이름이며 CD에서는 commit SHA tag를 process 환경으로 덮어쓴다.
BACKEND_IMAGE_REPOSITORY=lingko-backend
BACKEND_IMAGE_TAG=local

DB_HOST=mysql
DB_PORT=3306
DB_NAME=lingko
DB_USER=lingko
DB_PASSWORD=
# MySQL root 비밀번호. 앱 계정과 다른 값을 권장하며 비우면 DB_PASSWORD를 사용한다(최초 volume 초기화 때만 적용).
DB_ROOT_PASSWORD=
# MySQL host 공개 주소. 기본 loopback이며 외부 DB 도구 접근이 꼭 필요할 때만 바꾼다.
DB_BIND_ADDRESS=127.0.0.1
DB_DRIVER=com.mysql.cj.jdbc.Driver
DB_TZ=Asia/Seoul
JPA_DDL_AUTO=none

JWT_SECRET_KEY=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=14
JWT_ALGORITHM=HS256

AZURE_SECRET_KEY=
AZURE_REGION=
# Azure 발음 평가 응답 대기 상한(초, 1~120). 초과하면 일시 장애로 보고 Worker가 재시도한다.
AZURE_RECOGNITION_TIMEOUT_SECONDS=30

GOOGLE_CLIENT_ID=

# native iOS Sign in with Apple App ID(Bundle ID). 예: com.example.app
APPLE_CLIENT_ID=com.byeok.lingko

# App Review 기간에만 활성화한다. 원문 코드는 저장하지 않고 SHA-256 hex와 기존 사용자 ID만 주입한다.
REVIEW_ACCESS_ENABLED=false
REVIEW_ACCESS_CODE_SHA256=
REVIEW_ACCESS_USER_ID=
REVIEW_ACCESS_MAX_ATTEMPTS=5
REVIEW_ACCESS_WINDOW_SECONDS=300
# TLS reverse proxy 뒤에서 X-Forwarded-For로 실제 클라이언트 IP를 복원한다(IP별 rate limit에 사용).
# loopback·사설망 proxy가 보낸 header만 신뢰한다. proxy 없이 직접 공개하면 none으로 설정한다.
SERVER_FORWARD_HEADERS_STRATEGY=native

REPLICATE_API_KEY=
REPLICATE_VERSION=
REPLICATE_MAX_POLL_ATTEMPTS=300
REPLICATE_POLL_INTERVAL_MS=1000
REPLICATE_CREATE_MAX_ATTEMPTS=4
REPLICATE_RETRY_INITIAL_DELAY_MS=1000
REPLICATE_RETRY_MAX_DELAY_MS=30000
REPLICATE_FRAME_RATE=24

AWS_S3_BUCKET=
AWS_S3_REGION=

# Docker awslogs가 사용하는 비밀값이 아닌 운영 로그 목적지다. API와 Worker는 장애 범위를 분리한다.
AWS_LOGS_REGION=us-east-1
AWS_LOGS_API_GROUP=/lingko/prod/api
AWS_LOGS_WORKER_GROUP=/lingko/prod/worker

EVALUATION_API_WORKER_ENABLED=false
EVALUATION_WORKER_LEASE_SECONDS=600

# 가이드 생성 HTTP API는 기본 비활성화한다. 활성화 시 32자 이상의 별도 Secret을 주입한다.
GUIDE_JOBS_API_ENABLED=false
GUIDE_JOBS_INTERNAL_TOKEN=
GUIDE_JOBS_REQUESTS_PER_MINUTE=2
GUIDE_JOBS_MAX_CONCURRENT=1

FFMPEG_PATH=ffmpeg
LOG_LEVEL=INFO
# AdMob Rewarded SSV는 전체 ca-app-pub ID가 아니라 callback의 숫자 ad_unit 값을 쉼표로 구분한다.
ADMOB_SSV_ENABLED=true
ADMOB_SSV_ALLOWED_AD_UNIT_IDS=iOS-numeric-ad-unit-id,Android-numeric-ad-unit-id
ADMOB_SSV_REWARD_ITEM=pronunciation_chance
ADMOB_SSV_REWARD_AMOUNT=1
ADMOB_SSV_SESSION_EXPIRY_MINUTES=15
