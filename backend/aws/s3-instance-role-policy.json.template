{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListLingKoPrefixes",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:ListBucketVersions"],
      "Resource": "__BUCKET_ARN__",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "evaluation-audio/*",
            "guide-segments/*",
            "images/*",
            "videos/*"
          ]
        }
      }
    },
    {
      "Sid": "ManageLingKoObjects",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:DeleteObjectVersion"
      ],
      "Resource": [
        "__BUCKET_ARN__/evaluation-audio/*",
        "__BUCKET_ARN__/guide-segments/*",
        "__BUCKET_ARN__/images/*",
        "__BUCKET_ARN__/videos/*"
      ]
    }
  ]
}
