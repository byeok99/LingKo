# 로컬 앱 실행에 필요한 공개 식별자와 endpoint 예시다. 실제 계정 값은 .env.local에 둔다.
GOOGLE_SERVER_CLIENT_ID=
LINGKO_API_BASE_URL=http://localhost:8080

# Ad Unit ID는 비밀값이 아니지만 앱·화면별 귀속을 잘못 섞지 않도록 환경별로 주입한다.
ADMOB_ANDROID_REWARDED_AD_UNIT_ID=
ADMOB_IOS_REWARDED_AD_UNIT_ID=
ADMOB_ANDROID_REVIEW_BANNER_AD_UNIT_ID=
ADMOB_ANDROID_PROFILE_BANNER_AD_UNIT_ID=
# iOS는 공용 IOS_BANNER 기본값이 있으며, 화면별 Ad Unit을 만든 경우에만 덮어쓴다.
ADMOB_IOS_REVIEW_BANNER_AD_UNIT_ID=ca-app-pub-5081228614816629/5340118206
ADMOB_IOS_PROFILE_BANNER_AD_UNIT_ID=ca-app-pub-5081228614816629/5340118206

# 로컬 실기기에서 운영 Ad Unit을 test mode로 요청할 때만 설정한다.
ADMOB_TEST_DEVICE_ID=
